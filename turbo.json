{
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ]
    },
    "start": {
      "dependsOn": [
        "build"
      ]
    },
    "test": {
      "cache": false,
      "dependsOn": [
        "build",
        "^test"
      ]
    },
    "lint": {
      "cache": false,
      "dependsOn": [
        "^lint"
      ]
    }
  }
}
